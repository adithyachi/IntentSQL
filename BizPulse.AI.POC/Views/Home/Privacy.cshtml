@{
    ViewData["Title"] = "About IntentSQL";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <!-- =========================================================
            HEADER
            ========================================================= -->

            <div class="mb-5">

                <div class="text-uppercase small fw-semibold text-primary mb-2">
                    About IntentSQL
                </div>

                <h1 class="display-5 fw-bold mb-3">
                    Understand the question.
                    <br />
                    Get the data.
                </h1>

                <p class="lead text-muted mb-0">
                    IntentSQL brings natural language understanding to
                    relational data, allowing users to ask business questions
                    without writing SQL manually.
                </p>

            </div>


            <!-- =========================================================
            WHAT IS INTENTSQL
            ========================================================= -->

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body p-4 p-lg-5">

                    <div class="text-uppercase small fw-semibold text-primary mb-2">
                        Natural Language to SQL
                    </div>

                    <h3 class="fw-bold mb-3">
                        What is IntentSQL?
                    </h3>

                    <p class="text-muted">
                        IntentSQL is an AI-powered natural-language-to-SQL
                        system that allows users to interact with business
                        data using everyday language.
                    </p>

                    <p class="text-muted mb-0">
                        Instead of writing SQL queries manually, users describe
                        what they want to know. IntentSQL interprets the
                        question, understands the underlying intent, uses the
                        available database structure, generates an appropriate
                        query, executes it, and presents the resulting data.
                    </p>

                </div>

            </div>


            <!-- =========================================================
            THE IDEA
            ========================================================= -->

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body p-4 p-lg-5">

                    <div class="text-uppercase small fw-semibold text-primary mb-2">
                        The Idea
                    </div>

                    <h3 class="fw-bold mb-3">
                        Ask questions, not queries.
                    </h3>

                    <p class="text-muted">
                        Business users often know what information they need,
                        but they should not have to understand database schemas,
                        joins, aggregation functions, or SQL syntax to obtain it.
                    </p>

                    <p class="text-muted mb-0">
                        IntentSQL explores how natural language can become a
                        more intuitive interface for interacting with
                        structured business data.
                    </p>

                </div>

            </div>


            <!-- =========================================================
            HOW IT WORKS
            ========================================================= -->

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body p-4 p-lg-5">

                    <div class="text-uppercase small fw-semibold text-primary mb-2">
                        The Workflow
                    </div>

                    <h3 class="fw-bold mb-4">
                        How IntentSQL works
                    </h3>


                    <div class="workflow">

                        <div class="workflow-step">

                            <div class="workflow-number">
                                1
                            </div>

                            <div>

                                <div class="fw-semibold">
                                    Ask a question
                                </div>

                                <div class="small text-muted">
                                    Describe the business information you need
                                    using natural language.
                                </div>

                            </div>

                        </div>


                        <div class="workflow-line"></div>


                        <div class="workflow-step">

                            <div class="workflow-number">
                                2
                            </div>

                            <div>

                                <div class="fw-semibold">
                                    Understand the intent
                                </div>

                                <div class="small text-muted">
                                    The system interprets what the question is
                                    asking for.
                                </div>

                            </div>

                        </div>


                        <div class="workflow-line"></div>


                        <div class="workflow-step">

                            <div class="workflow-number">
                                3
                            </div>

                            <div>

                                <div class="fw-semibold">
                                    Understand the data structure
                                </div>

                                <div class="small text-muted">
                                    Available tables, columns, and relationships
                                    provide the context required to construct
                                    the query.
                                </div>

                            </div>

                        </div>


                        <div class="workflow-line"></div>


                        <div class="workflow-step">

                            <div class="workflow-number">
                                4
                            </div>

                            <div>

                                <div class="fw-semibold">
                                    Generate SQL
                                </div>

                                <div class="small text-muted">
                                    The natural-language request is translated
                                    into an SQL query.
                                </div>

                            </div>

                        </div>


                        <div class="workflow-line"></div>


                        <div class="workflow-step">

                            <div class="workflow-number">
                                5
                            </div>

                            <div>

                                <div class="fw-semibold">
                                    Execute and return results
                                </div>

                                <div class="small text-muted">
                                    The query is executed against the underlying
                                    data and the results are presented to the user.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =========================================================
            LLM
            ========================================================= -->

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body p-4 p-lg-5">

                    <div class="text-uppercase small fw-semibold text-primary mb-2">
                        Artificial Intelligence
                    </div>

                    <h3 class="fw-bold mb-3">
                        Large Language Model
                    </h3>

                    <p class="text-muted">
                        IntentSQL uses a Large Language Model (LLM) to
                        understand natural-language business questions and
                        translate them into SQL queries.
                    </p>

                    <p class="text-muted mb-4">
                        The LLM works together with database schema information
                        so that the generated query can be aligned with the
                        available tables, columns, and relationships.
                    </p>


                    <div class="row g-3">

                        <div class="col-md-4">

                            <div class="info-card h-100">

                                <div class="info-icon">
                                    💬
                                </div>

                                <h5 class="fw-bold">
                                    Natural Language
                                </h5>

                                <p class="small text-muted mb-0">
                                    Users communicate using ordinary business
                                    questions rather than SQL syntax.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="info-card h-100">

                                <div class="info-icon">
                                    🧠
                                </div>

                                <h5 class="fw-bold">
                                    Intent Understanding
                                </h5>

                                <p class="small text-muted mb-0">
                                    The system interprets the meaning and
                                    analytical requirements behind the question.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="info-card h-100">

                                <div class="info-icon">
                                    🗄️
                                </div>

                                <h5 class="fw-bold">
                                    SQL Generation
                                </h5>

                                <p class="small text-muted mb-0">
                                    The interpreted request is translated into
                                    a query that can be executed against the data.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =========================================================
            READ ONLY
            ========================================================= -->

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body p-4 p-lg-5">

                    <div class="d-flex align-items-start">

                        <div class="readonly-icon me-3">
                            ✓
                        </div>

                        <div>

                            <div class="text-uppercase small fw-semibold text-primary mb-2">
                                Read-only Analytics
                            </div>

                            <h3 class="fw-bold mb-2">
                                Designed for safe exploration
                            </h3>

                            <p class="text-muted mb-0">
                                The current implementation focuses on
                                read-only analytics. Generated queries are
                                restricted to <code>SELECT</code> statements
                                and are intended to retrieve information
                                without modifying the underlying data.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =========================================================
            TRANSPARENCY
            ========================================================= -->

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body p-4 p-lg-5">

                    <div class="text-uppercase small fw-semibold text-primary mb-2">
                        Transparency
                    </div>

                    <h3 class="fw-bold mb-3">
                        See what happened behind the answer.
                    </h3>

                    <p class="text-muted">
                        IntentSQL keeps execution information for each
                        question so that generated queries and system
                        behavior can be inspected rather than hidden
                        behind a simple answer.
                    </p>


                    <div class="row g-3 mt-1">

                        <div class="col-md-6">

                            <ul class="list-unstyled text-muted mb-0">

                                <li class="mb-2">
                                    <span class="text-primary me-2">✓</span>
                                    Generated SQL
                                </li>

                                <li class="mb-2">
                                    <span class="text-primary me-2">✓</span>
                                    Query results
                                </li>

                                <li class="mb-2">
                                    <span class="text-primary me-2">✓</span>
                                    Token usage
                                </li>

                            </ul>

                        </div>


                        <div class="col-md-6">

                            <ul class="list-unstyled text-muted mb-0">

                                <li class="mb-2">
                                    <span class="text-primary me-2">✓</span>
                                    Processing time
                                </li>

                                <li class="mb-2">
                                    <span class="text-primary me-2">✓</span>
                                    SQL generation attempts
                                </li>

                                <li class="mb-2">
                                    <span class="text-primary me-2">✓</span>
                                    Execution status
                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =========================================================
            CURRENT SCOPE
            ========================================================= -->

            <div class="card shadow-sm border-0">

                <div class="card-body p-4 p-lg-5">

                    <div class="text-uppercase small fw-semibold text-primary mb-2">
                        Current Scope
                    </div>

                    <h3 class="fw-bold mb-3">
                        A working proof of concept
                    </h3>

                    <p class="text-muted">
                        IntentSQL is currently a proof of concept exploring
                        natural-language interaction with structured business
                        data.
                    </p>

                    <p class="text-muted mb-0">
                        The focus is on understanding how effectively an
                        AI-powered system can translate real business questions
                        into database queries while keeping the generated SQL,
                        execution process, and results visible for inspection.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* =============================================================
           WORKFLOW
           ============================================================= */

    .workflow {
        display: flex;
        flex-direction: column;
    }

    .workflow-step {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .workflow-number {
        width: 30px;
        height: 30px;
        min-width: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background-color: #0d6efd;
        color: white;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .workflow-line {
        height: 20px;
        margin-left: 14px;
        border-left: 2px dotted #b8c9dc;
    }


    /* =============================================================
           AI INFORMATION CARDS
           ============================================================= */

    .info-card {
        padding: 18px;
        border: 1px solid #e1e8f0;
        border-radius: 8px;
        background-color: #fafbfd;
    }

    .info-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        border-radius: 8px;
        background-color: #e7f1ff;
        font-size: 1.1rem;
    }


    /* =============================================================
           READ ONLY
           ============================================================= */

    .readonly-icon {
        width: 34px;
        height: 34px;
        min-width: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background-color: #198754;
        color: white;
        font-weight: 700;
    }


    /* =============================================================
           RESPONSIVE
           ============================================================= */

    @@media (max-width: 767.98px) {

        .display-5 {
            font-size: 2.2rem;
        }
    }

</style>