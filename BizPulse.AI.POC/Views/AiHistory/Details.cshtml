    </div> *@


    @* ============================================================
    TOKEN USAGE
    ============================================================ *@

    <div class="card mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Token Usage</strong>
            @if (Model.ThinkEnabled)
            {
                <span class="badge bg-primary">Think Enabled</span>
            }
            else
            {
                <span class="badge bg-secondary">Think Disabled</span>
            }
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-3">

                    <div class="border rounded p-3">

                        <div class="text-muted">
                            Input Tokens
                        </div>

                        <div class="fs-3 fw-bold">
                            @Model.InputTokens.ToString("N0")
                        </div>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="border rounded p-3">

                        <div class="text-muted">
                            Output Tokens
                        </div>

                        <div class="fs-3 fw-bold">
                            @Model.OutputTokens.ToString("N0")
                        </div>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="border rounded p-3">

                        <div class="text-muted">
                            Reasoning Tokens
                        </div>

                        <div class="fs-3 fw-bold">
                            @Model.ReasoningTokens.ToString("N0")
                        </div>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="border rounded p-3">

                        <div class="text-muted">
                            Total Tokens
                        </div>

                        <div class="fs-3 fw-bold">
                            @Model.TotalTokens.ToString("N0")
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    @* ============================================================
    PERFORMANCE
    ============================================================ *@

    <div class="card mb-4">

        <div class="card-header">
            <strong>Performance</strong>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">

                        <div class="text-muted">
                            AI Response Time
                        </div>

                        <div class="fs-4 fw-bold">
                            @((Model.ResponseTimeMs / 1000.0).ToString("F2")) seconds
                        </div>

                    </div>
                </div>


                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">

                        <div class="text-muted">
                            Total Processing Time
                        </div>

                        <div class="fs-4 fw-bold">
                            @((Model.TotalProcessingTimeMs / 1000.0).ToString("F2")) seconds
                        </div>

                    </div>
                </div>


                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">

                        <div class="text-muted">
                            SQL Attempts
                        </div>

                        <div class="fs-4 fw-bold">
                            @Model.Attempts.Count
                        </div>

                    </div>
                </div>

            </div>

        </div>

    </div>

    </div>


    @* ============================================================
    FINAL SQL
    ============================================================ *@

    @if (!string.IsNullOrWhiteSpace(Model.FinalSql))
    {
        <div class="card mb-4">

            <div class="card-header">
                <strong>Final SQL</strong>
            </div>

            <div class="card-body">

                <pre class="mb-0"
                     style="white-space: pre-wrap;">@Model.FinalSql</pre>

            </div>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(Model.Reasoning))
    {
        <div class="card mb-4 border-primary" id="reasoning">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">Reasoning captured</div>
                    <div class="small text-muted">Think mode was enabled for this execution.</div>
                </div>
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#reasoningModal">
                    Show Reasoning
                </button>
            </div>
        </div>

        <div class="modal fade" id="reasoningModal" tabindex="-1" aria-labelledby="reasoningModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="reasoningModalLabel">Reasoning</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@Model.Reasoning</pre>
                    </div>
                </div>
            </div>
        </div>
    }


    @* ============================================================
    ERROR
    ============================================================ *@

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="card border-danger mb-4">

            <div class="card-header bg-danger text-white">
                <strong>Execution Error</strong>
            </div>

            <div class="card-body">

                <div style="white-space: pre-wrap;">
                    @Model.Error
                </div>

            </div>

        </div>
    }


    @* ============================================================
    ATTEMPT HISTORY
    ============================================================ *@

    <div class="card mb-5">

        <div class="card-header">

            <strong>
                SQL Generation Attempts
            </strong>

        </div>

        <div class="card-body">

            @if (Model.Attempts.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No SQL attempts were recorded.
                </div>
            }
            else
            {
                @foreach (var attempt in Model.Attempts)
                {
                    <div class="card mb-4">

                        <div class="card-header d-flex justify-content-between align-items-center">

                            <strong>
                                Attempt @attempt.AttemptNumber
                            </strong>

                            <div>

                                @if (attempt.Success)
                                {
                                    <span class="badge bg-success">
                                        Success
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Failed
                                    </span>
                                }

                                <span class="badge bg-secondary ms-2">

                                    @((attempt.GenerationTimeMs / 1000.0)
                                        .ToString("F2")) seconds

                                </span>

                            </div>

                        </div>


                        <div class="card-body">

                            <h6>
                                Generated SQL
                            </h6>

                            <pre class="mb-3"
                                 style="white-space: pre-wrap;">@attempt.Sql</pre>


                            @if (!string.IsNullOrWhiteSpace(attempt.Error))
                            {
                                <div class="alert alert-warning mb-0">

                                    <strong>
                                        PostgreSQL / Execution Error
                                    </strong>

                                    <div class="mt-2"
                                         style="white-space: pre-wrap;">
                                        @attempt.Error
                                    </div>

                                </div>
                            }

                        </div>

                    </div>
                }
            }

        </div>

    </div>

</div>