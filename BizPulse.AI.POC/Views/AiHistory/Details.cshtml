@model BizPulse.AI.POC.Models.AiAgentExecution

@{
    ViewData["Title"] = "IntentSQL Execution Details";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1>AI Execution Details</h1>

            <p class="text-muted mb-0">
                Execution #@Model.Id
            </p>

        </div>

        <div>

            <a asp-controller="AiHistory"
               asp-action="Index"
               class="btn btn-outline-secondary">

                ← Back to History

            </a>

            <a asp-controller="AiTest"
               asp-action="Index"
               class="btn btn-primary">

                Ask IntentSQL

            </a>

        </div>

    </div>


    @* ============================================================
    QUESTION
    ============================================================ *@

    <div class="card mb-4">

        <div class="card-header">
            <strong>Question</strong>
        </div>

        <div class="card-body">

            <div style="white-space: pre-wrap;">
                @Model.Question
            </div>

        </div>

    </div>


    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header"><strong>Mode</strong></div>
                <div class="card-body">
                    @if (Model.Mode == "Conversation")
                    {
                        <span class="badge bg-info text-dark fs-6">Conversation</span>
                    }
                    else
                    {
                        <span class="badge bg-primary fs-6">Strict SQL</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Response</strong>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.Response))
                    {
                        <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@Model.Response</pre>
                    }
                    else
                    {
                        <span class="text-muted">No response was recorded.</span>
                    }
                </div>
            </div>
        </div>
    </div>


    @* ============================================================
    AI INFORMATION
    ============================================================ *@

    @* <div class="card mb-4">

        <div class="card-header">
            <strong>AI Information</strong>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-3">

                    <div class="border rounded p-3 h-100">

                        <div class="text-muted small">
                            Provider
                        </div>

                        <div class="fw-bold">
                            @Model.Provider
                        </div>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="border rounded p-3 h-100">

                        <div class="text-muted small">
                            Model
                        </div>

                        <div class="fw-bold">
                            @Model.Model
                        </div>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="border rounded p-3 h-100">

                        <div class="text-muted small">
                            Created
                        </div>

                        <div class="fw-bold">
                            @(Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss"))
                        </div>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="border rounded p-3 h-100">

                        <div class="text-muted small">
                            Status
                        </div>

                        <div>

                            @if (Model.Success)
                            {
                                <span class="badge bg-success">
                                    Success
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Failed
                                </span>
                            }

                        </div>

