@model IReadOnlyList<BizPulse.AI.POC.Models.AiAgentExecution>

@{
    ViewData["Title"] = "IntentSQL Agent History";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">
                AI Agent History
            </h1>

            <p class="text-muted mb-0">
                History of questions executed by the IntentSQL AI agent.
            </p>
        </div>


        <div class="d-flex align-items-center gap-2">

            <a asp-controller="AiHistory"
               asp-action="Index"
               class="btn btn-outline-secondary">

                ↻ Refresh

            </a>

            <a asp-controller="AiTest"
               asp-action="Ask"
               class="btn btn-primary">

                Ask IntentSQL

            </a>

        </div>

    </div>


    @if (Model.Count == 0)
    {
        <div class="alert alert-info">

            No AI executions have been recorded yet.

        </div>
    }
    else
    {
        <div class="card">

            <div class="card-body">

                <div class="table-responsive history-table-wrapper">

                    <table class="table table-bordered table-striped align-middle history-table">

                        <colgroup>
                            <col class="history-col-date" />
                            <col class="history-col-question" />
                            <col class="history-col-mode" />
                            <col class="history-col-number" />
                            <col class="history-col-number" />
                            <col class="history-col-number" />
                            <col class="history-col-time" />
                            <col class="history-col-action" />
                            <col class="history-col-action" />
                            <col class="history-col-status" />
                            <col class="history-col-details" />
                        </colgroup>

                        <thead class="table-dark">

                            <tr>

                                <th>
                                    Date / Time
                                </th>

                                <th>
                                    Question
                                </th>

                                <th>
                                    Mode
                                </th>

                                @*<th>
                            Provider
                            </th>

                            <th>
                            Model
                            </th> *@

                                <th>
                                    Input
                                </th>

                                <th>
                                    Output
                                </th>

                                <th>
                                    Total
                                </th>

                                <th>
                                    Response
                                </th>

                                <th>
                                    View
                                </th>

                                <th>
                                    Reasoning
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var execution in Model)
                            {
                                <tr>

                                    <td class="text-nowrap">

                                        @ToIndiaTime(execution.CreatedAt).ToString("dd MMM yyyy HH:mm:ss 'IST'")

                                    </td>


                                    <td class="history-question">

                                        @execution.Question

                                    </td>


                                    <td class="text-center text-nowrap">
                                        @if (execution.Mode == "Conversation")
                                        {
                                            <span class="badge bg-info text-dark">Conversation</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">Strict SQL</span>
                                        }
                                    </td>


                                    @*                                     <td>

                            @if (execution.Provider == "TogetherAI")
                            {
                            <span class="badge bg-primary">
                            Cloud
                            </span>
                            }
                            else
                            {
                            <span class="badge bg-secondary">
                            Local
                            </span>
                            }

                            <div class="small text-muted mt-1">
                            @execution.Provider
                            </div>

                            </td> *@


                                    @*                                     <td>

                            <span class="small">
                            @execution.Model
                            </span>

                            </td> *@


                                    <td class="text-end">

                                        @execution.InputTokens.ToString("N0")

                                    </td>


                                    <td class="text-end">

                                        @execution.OutputTokens.ToString("N0")

                                    </td>


                                    <td class="text-end fw-bold">

                                        @execution.TotalTokens.ToString("N0")

                                    </td>



                                    <td class="text-end text-nowrap">

                                        @((execution.ResponseTimeMs / 1000.0).ToString("F2")) s

                                    </td>


                                    <td class="text-center">
                                        @if (!string.IsNullOrWhiteSpace(execution.Response))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#responseModal-@execution.Id">
                                                View Response
                                            </button>

                                            <div class="modal fade" id="responseModal-@execution.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Response — @execution.Mode</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body text-start">
                                                            <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@execution.Response</pre>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">None</span>
                                        }
                                    </td>


                                    <td class="text-center">
                                        @if (!string.IsNullOrWhiteSpace(execution.Reasoning))
                                        {
                                            <a asp-controller="AiHistory" asp-action="Details" asp-route-id="@execution.Id" asp-fragment="reasoning" class="btn btn-sm btn-outline-primary">
                                                Show Reasoning
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">None</span>
                                        }
                                    </td>


                                    <td class="text-center">

                                        @if (execution.Success)
                                        {
                                            <span class="badge bg-success">
                                                Success
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Failed
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <a asp-controller="AiHistory"
                                           asp-action="Details"
                                           asp-route-id="@execution.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            Details

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <div class="mt-3 text-muted">

            @Model.Count execution(s) recorded.

        </div>
    }

</div>

@functions {

    private static DateTime ToIndiaTime(DateTime value)
    {
        var utcValue = value.Kind == DateTimeKind.Utc
            ? value
            : DateTime.SpecifyKind(value, DateTimeKind.Utc);

        TimeZoneInfo indiaTimeZone;

        try
        {
            // Windows time-zone ID (local development).
            indiaTimeZone = TimeZoneInfo.FindSystemTimeZoneById("India Standard Time");
        }
        catch (TimeZoneNotFoundException)
        {
            // IANA time-zone ID (Linux/Azure Container Apps).
            indiaTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata");
        }

        return TimeZoneInfo.ConvertTimeFromUtc(utcValue, indiaTimeZone);
    }

}

<style>
    /*
           AI History table:
           Keep every column contained inside its own cell.
           The question column gets the most room; action columns remain readable.
        */
    .history-table-wrapper {
        width: 100%;
        overflow-x: hidden;
    }

    .history-table {
        width: 100%;
        table-layout: fixed;
        font-size: 0.82rem;
        margin-bottom: 0;
    }

        .history-table th,
        .history-table td {
            box-sizing: border-box;
            vertical-align: middle;
            min-width: 0;
            overflow: hidden;
        }

        .history-table th {
            white-space: nowrap;
            line-height: 1.15;
            font-size: 0.78rem;
        }

        .history-table td {
            white-space: normal;
            overflow-wrap: break-word;
            word-break: normal;
        }

    .history-question {
        white-space: normal !important;
        overflow-wrap: break-word;
        word-break: normal;
    }

    .history-table td.text-nowrap {
        white-space: nowrap !important;
        text-overflow: clip;
    }

    /* 11 visible columns = 100%. */
    .history-col-date {
        width: 13%;
    }

    .history-col-question {
        width: 24%;
    }

    .history-col-mode {
        width: 8%;
    }

    .history-col-number {
        width: 6%;
    }

    .history-col-time {
        width: 9%;
    }

    .history-col-action {
        width: 8%;
    }

    .history-col-status {
        width: 5%;
    }

    .history-col-details {
        width: 7%;
    }

    /* Response / Reasoning / Details buttons stay inside their own cells. */
    .history-table td .btn {
        display: block;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
        white-space: normal;
        overflow-wrap: break-word;
        word-break: normal;
        text-align: center;
        line-height: 1.15;
        font-size: 0.72rem;
        padding: 0.3rem 0.25rem;
        margin: 0;
    }

    .history-table .badge {
        display: inline-block;
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: clip;
        line-height: 1.15;
    }

    @@media (max-width: 1100px) {
        .history-table {
            font-size: 0.74rem;
        }

            .history-table th {
                font-size: 0.7rem;
            }

            .history-table td .btn {
                font-size: 0.65rem;
                padding: 0.25rem 0.2rem;
            }
    }
</style>
