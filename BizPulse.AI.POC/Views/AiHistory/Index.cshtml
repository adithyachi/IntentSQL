@model IReadOnlyList<BizPulse.AI.POC.Models.AiAgentExecution>

@{
    ViewData["Title"] = "IntentSQL Agent History";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">
                AI Agent History
            </h1>

            <p class="text-muted mb-0">
                History of questions executed by the IntentSQL AI agent.
            </p>
        </div>


        <div class="d-flex align-items-center gap-2">

            <a asp-controller="AiHistory"
               asp-action="Index"
               class="btn btn-outline-secondary">

                ↻ Refresh

            </a>

            <a asp-controller="AiTest"
               asp-action="Ask"
               class="btn btn-primary">

                Ask IntentSQL

            </a>

        </div>

    </div>


    @if (Model.Count == 0)
    {
        <div class="alert alert-info">

            No AI executions have been recorded yet.

        </div>
    }
    else
    {
        <div class="card">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered table-striped align-middle">

                        <thead class="table-dark">

                            <tr>

                                <th>
                                    Date / Time
                                </th>

                                <th>
                                    Question
                                </th>

@*                                 <th>
                                    Provider
                                </th>

                                <th>
                                    Model
                                </th> *@

                                <th>
                                    Input
                                </th>

                                <th>
                                    Output
                                </th>

                                <th>
                                    Total
                                </th>

                                <th>
                                    Attempts
                                </th>

                                <th>
                                    Response
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var execution in Model)
                            {
                                <tr>

                                    <td class="text-nowrap">

                                        @(execution.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss"))

                                    </td>


                                    <td style="min-width: 300px;">

                                        @execution.Question

                                    </td>


@*                                     <td>

                                        @if (execution.Provider == "TogetherAI")
                                        {
                                            <span class="badge bg-primary">
                                                Cloud
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Local
                                            </span>
                                        }

                                        <div class="small text-muted mt-1">
                                            @execution.Provider
                                        </div>

                                    </td> *@


@*                                     <td>

                                        <span class="small">
                                            @execution.Model
                                        </span>

                                    </td> *@


                                    <td class="text-end">

                                        @execution.InputTokens.ToString("N0")

                                    </td>


                                    <td class="text-end">

                                        @execution.OutputTokens.ToString("N0")

                                    </td>


                                    <td class="text-end fw-bold">

                                        @execution.TotalTokens.ToString("N0")

                                    </td>


                                    <td class="text-center">

                                        @execution.Attempts.Count

                                    </td>


                                    <td class="text-end text-nowrap">

                                        @((execution.ResponseTimeMs / 1000.0).ToString("F2")) s

                                    </td>


                                    <td class="text-center">

                                        @if (execution.Success)
                                        {
                                            <span class="badge bg-success">
                                                Success
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Failed
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <a asp-controller="AiHistory"
                                           asp-action="Details"
                                           asp-route-id="@execution.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            Details

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <div class="mt-3 text-muted">

            @Model.Count execution(s) recorded.

        </div>
    }

</div>