@model IReadOnlyList<BizPulse.AI.POC.Models.AiAgentExecution>

@{
    ViewData["Title"] = "IntentSQL Agent History";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">
                AI Agent History
            </h1>

            <p class="text-muted mb-0">
                History of questions executed by the IntentSQL AI agent.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">

            <a asp-controller="AiHistory"
               asp-action="Index"
               class="btn btn-outline-secondary">
                ↻ Refresh
            </a>

            <a asp-controller="AiTest"
               asp-action="Ask"
               class="btn btn-primary">
                Ask IntentSQL
            </a>

        </div>

    </div>


    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No AI executions have been recorded yet.
        </div>
    }
    else
    {
        <div class="card">

            <div class="card-body history-card-body">

                <div class="history-table-wrapper">

                    <table class="table table-bordered table-striped align-middle history-table">

                        <colgroup>

                            <col class="col-date" />
                            <col class="col-question" />
                            <col class="col-mode" />

                            <col class="col-token" />
                            <col class="col-token" />
                            <col class="col-token" />

                            <col class="col-response-time" />

                            <col class="col-action" />
                            <col class="col-action" />

                            <col class="col-status" />

                            <col class="col-details" />

                        </colgroup>


                        <thead class="table-dark">

                            <tr>

                                <th>
                                    Date / Time
                                </th>

                                <th>
                                    Question
                                </th>

                                <th>
                                    Mode
                                </th>

                                <th class="text-center">
                                    Input
                                </th>

                                <th class="text-center">
                                    Output
                                </th>

                                <th class="text-center">
                                    Total
                                </th>

                                <th class="text-center">
                                    Response
                                </th>

                                <th class="text-center">
                                    Response
                                </th>

                                <th class="text-center">
                                    Reasoning
                                </th>

                                <th class="text-center">
                                    Status
                                </th>

                                <th class="text-center">
                                    Details
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var execution in Model)
                            {
                                <tr>

                                    <!-- DATE -->

                                    <td class="history-date">

                                        @(ToIndiaTime(execution.CreatedAt).ToString("dd MMM yyyy HH:mm:ss"))

                                    </td>


                                    <!-- QUESTION -->

                                    <td class="history-question">

                                        @execution.Question

                                    </td>


                                    <!-- MODE -->

                                    <td class="text-center">

                                        @if (execution.Mode == "Conversation")
                                        {
                                            <span class="badge bg-info text-dark history-mode-badge">
                                                Chat
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary history-mode-badge">
                                                Strict SQL
                                            </span>
                                        }

                                    </td>


                                    <!-- INPUT TOKENS -->

                                    <td class="text-end history-number">

                                        @execution.InputTokens.ToString("N0")

                                    </td>


                                    <!-- OUTPUT TOKENS -->

                                    <td class="text-end history-number">

                                        @execution.OutputTokens.ToString("N0")

                                    </td>


                                    <!-- TOTAL TOKENS -->

                                    <td class="text-end history-number fw-bold">

                                        @execution.TotalTokens.ToString("N0")

                                    </td>


                                    <!-- RESPONSE TIME -->

                                    <td class="text-center history-response-time">

                                        @((execution.ResponseTimeMs / 1000.0).ToString("F2")) s

                                    </td>


                                    <!-- RESPONSE -->

                                    <td class="text-center history-action-cell">

                                        @if (!string.IsNullOrWhiteSpace(execution.Response))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-success history-action-btn"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#responseModal-@execution.Id">

                                                Response

                                            </button>


                                            <div class="modal fade"
                                                 id="responseModal-@execution.Id"
                                                 tabindex="-1"
                                                 aria-hidden="true">

                                                <div class="modal-dialog modal-xl modal-dialog-scrollable">

                                                    <div class="modal-content">

                                                        <div class="modal-header">

                                                            <h5 class="modal-title">
                                                                Response — @execution.Mode
                                                            </h5>

                                                            <button type="button"
                                                                    class="btn-close"
                                                                    data-bs-dismiss="modal"
                                                                    aria-label="Close">
                                                            </button>

                                                        </div>

                                                        <div class="modal-body text-start">

                                                            <pre class="mb-0 history-modal-response">@execution.Response</pre>

                                                        </div>

                                                    </div>

                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                None
                                            </span>
                                        }

                                    </td>


                                    <!-- REASONING -->

                                    <td class="text-center history-action-cell">

                                        @if (!string.IsNullOrWhiteSpace(execution.Reasoning))
                                        {
                                            <a asp-controller="AiHistory"
                                               asp-action="Details"
                                               asp-route-id="@execution.Id"
                                               asp-fragment="reasoning"
                                               class="btn btn-sm btn-outline-primary history-action-btn">

                                                Reasoning

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                None
                                            </span>
                                        }

                                    </td>


                                    <!-- STATUS -->

                                    <td class="text-center history-status-cell">

                                        @if (execution.Success)
                                        {
                                            <span class="badge bg-success history-status-badge">
                                                Success
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger history-status-badge">
                                                Failed
                                            </span>
                                        }

                                    </td>


                                    <!-- DETAILS -->

                                    <td class="text-center history-action-cell">

                                        <a asp-controller="AiHistory"
                                           asp-action="Details"
                                           asp-route-id="@execution.Id"
                                           class="btn btn-sm btn-outline-primary history-action-btn">

                                            Details

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <div class="mt-3 text-muted">

            @Model.Count execution(s) recorded.

        </div>
    }

</div>


@functions {

    private static DateTime ToIndiaTime(DateTime value)
    {
        var utcValue = value.Kind == DateTimeKind.Utc
            ? value
            : DateTime.SpecifyKind(value, DateTimeKind.Utc);

        TimeZoneInfo indiaTimeZone;

        try
        {
            // Windows / local development.
            indiaTimeZone =
                TimeZoneInfo.FindSystemTimeZoneById(
                    "India Standard Time");
        }
        catch (TimeZoneNotFoundException)
        {
            // Linux / Azure Container Apps.
            indiaTimeZone =
                TimeZoneInfo.FindSystemTimeZoneById(
                    "Asia/Kolkata");
        }

        return TimeZoneInfo.ConvertTimeFromUtc(
            utcValue,
            indiaTimeZone);
    }

}


<style>

    /*
         * ============================================================
         * AI HISTORY TABLE
         * ============================================================
         *
         * Important:
         * - No horizontal scrolling.
         * - Fixed layout with carefully balanced column widths.
         * - Action buttons use short labels.
         * - Question gets the largest amount of space.
         * - Response time and status have dedicated space.
         */

    .history-card-body {
        padding: 1rem;
    }


    .history-table-wrapper {
        width: 100%;
        overflow-x: hidden;
    }


    .history-table {
        width: 100%;
        max-width: 100%;
        margin-bottom: 0;
        table-layout: fixed;
        font-size: 0.80rem;
    }


        /*
         * ------------------------------------------------------------
         * COLUMN WIDTHS
         * ------------------------------------------------------------
         *
         * Total = 100%
         *
         * Date          12%
         * Question      25%
         * Mode           8%
         * Tokens        15%
         * Response time  7%
         * Response       8%
         * Reasoning      8%
         * Status         6%
         * Details        6%
         */

        .history-table .col-date {
            width: 12%;
        }

        .history-table .col-question {
            width: 25%;
        }

        .history-table .col-mode {
            width: 8%;
        }

        .history-table .col-token {
            width: 5%;
        }

        .history-table .col-response-time {
            width: 7%;
        }

        .history-table .col-action {
            width: 8%;
        }

        .history-table .col-status {
            width: 6%;
        }

        .history-table .col-details {
            width: 6%;
        }


        /*
         * ------------------------------------------------------------
         * CELLS
         * ------------------------------------------------------------
         */

        .history-table th,
        .history-table td {
            box-sizing: border-box;
            vertical-align: middle;
            min-width: 0;
            overflow: hidden;
        }


        .history-table th {
            padding: 0.55rem 0.35rem;
            white-space: normal;
            line-height: 1.15;
            font-size: 0.75rem;
            text-align: center;
        }


        .history-table td {
            padding: 0.55rem 0.35rem;
            white-space: normal;
            overflow-wrap: anywhere;
            word-break: normal;
            line-height: 1.25;
        }


    /*
         * ------------------------------------------------------------
         * DATE
         * ------------------------------------------------------------
         */

    .history-date {
        white-space: nowrap !important;
        font-size: 0.72rem;
        overflow: hidden;
        text-overflow: clip;
    }


    /*
         * ------------------------------------------------------------
         * QUESTION
         * ------------------------------------------------------------
         */

    .history-question {
        white-space: normal !important;
        overflow-wrap: anywhere;
        word-break: normal;
        line-height: 1.3;
    }


    /*
         * ------------------------------------------------------------
         * MODE
         * ------------------------------------------------------------
         */

    .history-mode-badge {
        display: inline-block;
        max-width: 100%;
        white-space: normal;
        overflow-wrap: anywhere;
        line-height: 1.15;
        padding: 0.3rem 0.35rem;
        font-size: 0.68rem;
    }


    /*
         * ------------------------------------------------------------
         * TOKEN VALUES
         * ------------------------------------------------------------
         */

    .history-number {
        white-space: nowrap !important;
        font-size: 0.75rem;
    }


    /*
         * ------------------------------------------------------------
         * RESPONSE TIME
         * ------------------------------------------------------------
         */

    .history-response-time {
        white-space: nowrap !important;
        font-size: 0.73rem;
    }


    /*
         * ------------------------------------------------------------
         * ACTION CELLS
         * ------------------------------------------------------------
         */

    .history-action-cell {
        padding-left: 0.25rem !important;
        padding-right: 0.25rem !important;
    }


    .history-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: normal;
        text-align: center;
        line-height: 1.1;
        font-size: 0.68rem;
        padding: 0.35rem 0.20rem;
        margin: 0;
    }


    /*
         * ------------------------------------------------------------
         * STATUS
         * ------------------------------------------------------------
         */

    .history-status-cell {
        padding-left: 0.25rem !important;
        padding-right: 0.25rem !important;
    }


    .history-status-badge {
        display: inline-block;
        max-width: 100%;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: normal;
        text-align: center;
        line-height: 1.1;
        font-size: 0.68rem;
        padding: 0.35rem 0.25rem;
    }


    /*
         * ------------------------------------------------------------
         * RESPONSE MODAL
         * ------------------------------------------------------------
         */

    .history-modal-response {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        word-break: break-word;
        font-family: inherit;
        max-width: 100%;
    }


    /*
         * ------------------------------------------------------------
         * MEDIUM SCREENS
         * ------------------------------------------------------------
         */

    @@media (max-width: 1200px) {

        .history-table {
            font-size: 0.74rem;
        }

            .history-table th {
                font-size: 0.70rem;
            }

            .history-table td {
                padding: 0.45rem 0.25rem;
            }

        .history-date {
            font-size: 0.65rem;
        }

        .history-action-btn {
            font-size: 0.62rem;
            padding: 0.3rem 0.15rem;
        }

        .history-status-badge {
            font-size: 0.62rem;
        }
    }


    /*
         * ------------------------------------------------------------
         * SMALLER SCREENS
         * ------------------------------------------------------------
         *
         * We still don't introduce a horizontal scrollbar.
         * Text/buttons are allowed to wrap.
         */

    @@media (max-width: 992px) {

        .history-card-body {
            padding: 0.5rem;
        }

        .history-table {
            font-size: 0.68rem;
        }

            .history-table th {
                font-size: 0.64rem;
            }

            .history-table td {
                padding: 0.35rem 0.20rem;
            }

        .history-date {
            white-space: normal !important;
            overflow-wrap: anywhere;
            font-size: 0.60rem;
        }

        .history-number {
            font-size: 0.64rem;
        }

        .history-response-time {
            white-space: normal !important;
            font-size: 0.62rem;
        }

        .history-action-btn {
            font-size: 0.58rem;
            padding: 0.25rem 0.10rem;
        }

        .history-status-badge {
            font-size: 0.58rem;
            padding: 0.25rem 0.15rem;
        }
    }

</style>